<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>ClassPulse - Student Dashboard</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>


    <!-- =====================================================
         NAVBAR
    ====================================================== -->

    <nav class="dashboard-navbar">

        <div class="dashboard-brand">

            <span class="brand-icon">
                📚
            </span>

            <span>
                ClassPulse
            </span>

        </div>


        <div class="dashboard-nav-links">

            <a href="/" class="nav-link">
                🏠 Home
            </a>

            <a href="/teacher" class="nav-link">
                👨‍🏫 Teacher
            </a>

            <a href="/student" class="nav-link active">
                👩‍🎓 Student
            </a>

        </div>


        <button
            class="logout-btn"
            onclick="logout()"
        >
            🚪 Logout
        </button>

    </nav>



    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="dashboard-container">


        <!-- Welcome -->

        <section class="dashboard-welcome">

            <div>

                <span class="welcome-label">
                    👋 Welcome Student
                </span>

                <h1>
                    Join Your Classroom
                </h1>

                <p>
                    Enter the unique class code provided
                    by your teacher.
                </p>

            </div>


            <div class="welcome-icon">
                👩‍🎓
            </div>

        </section>



        <!-- =================================================
             JOIN CLASS
        ================================================== -->

        <section class="dashboard-card">

            <div class="card-heading">

                <div class="card-icon">
                    🔑
                </div>

                <div>

                    <h2>
                        Join a Class
                    </h2>

                    <p>
                        Enter the class code to access the quiz.
                    </p>

                </div>

            </div>


            <form id="join-class-form">

                <div class="form-group">

                    <label for="classCode">
                        🔐 Class Code
                    </label>

                    <input
                        type="text"
                        id="classCode"
                        placeholder="Example: ABC123"
                        maxlength="6"
                        style="text-transform: uppercase;"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="primary-btn"
                >
                    🚀 Join Class
                </button>

            </form>


            <div
                id="join-error"
                class="error-message hidden"
            ></div>

        </section>



        <!-- =================================================
             CLASS CONTENT
        ================================================== -->

        <section
            id="class-content"
            class="dashboard-card hidden"
        >

            <div class="class-header">

                <div>

                    <span class="class-code-label">
                        CLASS CODE
                    </span>

                    <h2 id="display-class-code">
                        ABC123
                    </h2>

                </div>

                <span class="live-badge">
                    🟢 LIVE
                </span>

            </div>


            <div class="topic-box">

                <span>
                    📖 Topic
                </span>

                <h2 id="class-topic">
                    Topic
                </h2>

            </div>


            <!-- Understanding -->

            <div class="understanding-section">

                <h3>
                    💭 How well do you understand this topic?
                </h3>


                <div class="understanding-options">

                    <button
                        type="button"
                        class="understanding-btn"
                        data-value="understand"
                    >
                        😊
                        <span>
                            I understand
                        </span>
                    </button>


                    <button
                        type="button"
                        class="understanding-btn"
                        data-value="somewhat"
                    >
                        🤔
                        <span>
                            Somewhat
                        </span>
                    </button>


                    <button
                        type="button"
                        class="understanding-btn"
                        data-value="dont-understand"
                    >
                        😕
                        <span>
                            I don't understand
                        </span>
                    </button>

                </div>

            </div>



            <!-- =================================================
                 QUIZ
            ================================================== -->

            <div class="quiz-section">

                <div class="quiz-number">
                    🧠 Quick Quiz
                </div>


                <h2 id="quiz-question">
                    Question will appear here
                </h2>


                <div
                    id="quiz-options"
                    class="quiz-answer-options"
                ></div>


                <button
                    id="submit-response"
                    class="primary-btn"
                    disabled
                >
                    ✅ Submit Response
                </button>

            </div>


            <!-- Result -->

            <div
                id="response-result"
                class="result-box hidden"
            >

                <div class="result-icon">
                    🎉
                </div>

                <h2>
                    Response Submitted!
                </h2>

                <p>
                    Your response has been recorded.
                </p>

            </div>

        </section>

    </main>



    <!-- =====================================================
         SCRIPT
    ====================================================== -->

    <script>

        let currentClassCode = "";

        let selectedUnderstanding = "";

        let selectedAnswer = null;



        // ==================================================
        // JOIN CLASS
        // ==================================================

        document
            .getElementById("join-class-form")
            .addEventListener(
                "submit",
                async function(event) {

                    event.preventDefault();


                    const code =
                        document
                            .getElementById("classCode")
                            .value
                            .trim()
                            .toUpperCase();


                    if (!code) return;


                    const errorBox =
                        document
                            .getElementById("join-error");


                    errorBox.classList.add(
                        "hidden"
                    );


                    try {

                        const response =
                            await fetch(
                                `/api/classrooms/${code}`
                            );


                        const data =
                            await response.json();


                        if (!response.ok) {

                            errorBox
                                .textContent =
                                data.message ||
                                "Class not found.";

                            errorBox
                                .classList
                                .remove("hidden");

                            return;

                        }


                        currentClassCode =
                            data.code;


                        // Show class

                        document
                            .getElementById(
                                "class-content"
                            )
                            .classList
                            .remove("hidden");


                        document
                            .getElementById(
                                "display-class-code"
                            )
                            .textContent =
                            data.code;


                        document
                            .getElementById(
                                "class-topic"
                            )
                            .textContent =
                            data.topic;


                        document
                            .getElementById(
                                "quiz-question"
                            )
                            .textContent =
                            data.quizQuestion;


                        // Create quiz options

                        const optionsContainer =
                            document.getElementById(
                                "quiz-options"
                            );


                        optionsContainer.innerHTML = "";


                        data.quizOptions.forEach(
                            function(option, index) {

                                const button =
                                    document.createElement(
                                        "button"
                                    );


                                button.type =
                                    "button";

                                button.className =
                                    "quiz-option";

                                button.textContent =
                                    option;


                                button.addEventListener(
                                    "click",
                                    function() {

                                        document
                                            .querySelectorAll(
                                                ".quiz-option"
                                            )
                                            .forEach(
                                                btn =>
                                                    btn.classList
                                                        .remove(
                                                            "selected"
                                                        )
                                            );


                                        button.classList.add(
                                            "selected"
                                        );


                                        selectedAnswer =
                                            index;


                                        checkSubmit();

                                    }
                                );


                                optionsContainer
                                    .appendChild(
                                        button
                                    );

                            }
                        );


                        // Scroll to class

                        document
                            .getElementById(
                                "class-content"
                            )
                            .scrollIntoView({
                                behavior: "smooth"
                            });


                    } catch (error) {

                        console.error(error);

                        errorBox
                            .textContent =
                            "Unable to connect to server.";

                        errorBox
                            .classList
                            .remove("hidden");

                    }

                }
            );



        // ==================================================
        // UNDERSTANDING BUTTONS
        // ==================================================

        document
            .querySelectorAll(
                ".understanding-btn"
            )
            .forEach(function(button) {

                button.addEventListener(
                    "click",
                    function() {

                        document
                            .querySelectorAll(
                                ".understanding-btn"
                            )
                            .forEach(
                                btn =>
                                    btn.classList
                                        .remove(
                                            "selected"
                                        )
                            );


                        button.classList.add(
                            "selected"
                        );


                        selectedUnderstanding =
                            button.dataset.value;


                        checkSubmit();

                    }
                );

            });



        // ==================================================
        // CHECK SUBMIT
        // ==================================================

        function checkSubmit() {

            const submitButton =
                document.getElementById(
                    "submit-response"
                );


            if (
                selectedUnderstanding &&
                selectedAnswer !== null
            ) {

                submitButton.disabled =
                    false;

            } else {

                submitButton.disabled =
                    true;

            }

        }



        // ==================================================
        // SUBMIT RESPONSE
        // ==================================================

        document
            .getElementById(
                "submit-response"
            )
            .addEventListener(
                "click",
                async function() {

                    try {

                        const response =
                            await fetch(
                                "/api/responses",
                                {

                                    method: "POST",

                                    headers: {
                                        "Content-Type":
                                            "application/json"
                                    },

                                    body: JSON.stringify({

                                        classCode:
                                            currentClassCode,

                                        understanding:
                                            selectedUnderstanding,

                                        quizAnswer:
                                            selectedAnswer

                                    })

                                }
                            );


                        const data =
                            await response.json();


                        if (!response.ok) {

                            alert(
                                data.message ||
                                "Could not submit response."
                            );

                            return;

                        }


                        document
                            .getElementById(
                                "response-result"
                            )
                            .classList
                            .remove(
                                "hidden"
                            );


                        document
                            .getElementById(
                                "submit-response"
                            )
                            .disabled =
                            true;


                    } catch (error) {

                        console.error(error);

                        alert(
                            "Unable to connect to server."
                        );

                    }

                }
            );



        // ==================================================
        // LOGOUT
        // ==================================================

        function logout() {

            window.location.href = "/";

        }

    </script>

</body>

</html>