<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ClassPulse - Teacher Dashboard</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <nav class="dashboard-navbar">

        <div class="dashboard-brand">
            <span class="brand-icon">📚</span>
            <span>ClassPulse</span>
        </div>

        <div class="dashboard-nav-links">

            <a href="/" class="nav-link">
                🏠 Home
            </a>

            <a href="/teacher" class="nav-link active">
                👨‍🏫 Teacher
            </a>

            <a href="/student" class="nav-link">
                👩‍🎓 Student
            </a>

        </div>

        <button class="logout-btn" onclick="logout()">
            🚪 Logout
        </button>

    </nav>


    <main class="dashboard-container">

        <section class="dashboard-welcome">

            <div>

                <span class="welcome-label">
                    👋 Welcome Teacher
                </span>

                <h1>
                    Create an Interactive Class
                </h1>

                <p>
                    Create a class, add a quiz question,
                    and let students participate using a unique code.
                </p>

            </div>

            <div class="welcome-icon">
                👨‍🏫
            </div>

        </section>


        <section class="dashboard-card">

            <div class="card-heading">

                <div class="card-icon">
                    🏫
                </div>

                <div>
                    <h2>Create New Class</h2>

                    <p>
                        Add a topic and create a quiz for your students.
                    </p>
                </div>

            </div>


            <form id="create-class-form">

                <div class="form-group">

                    <label for="topic">
                        📖 Class Topic
                    </label>

                    <input
                        type="text"
                        id="topic"
                        name="topic"
                        placeholder="Example: Python Basics"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="quizQuestion">
                        ❓ Quiz Question
                    </label>

                    <textarea
                        id="quizQuestion"
                        name="quizQuestion"
                        rows="3"
                        placeholder="Enter your quiz question..."
                        required
                    ></textarea>

                </div>


                <div class="quiz-options-grid">

                    <div class="form-group">

                        <label>
                            🔵 Option 1
                        </label>

                        <input
                            type="text"
                            id="option0"
                            placeholder="Enter option 1"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            🟢 Option 2
                        </label>

                        <input
                            type="text"
                            id="option1"
                            placeholder="Enter option 2"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            🟡 Option 3
                        </label>

                        <input
                            type="text"
                            id="option2"
                            placeholder="Enter option 3"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            🟣 Option 4
                        </label>

                        <input
                            type="text"
                            id="option3"
                            placeholder="Enter option 4"
                            required
                        >

                    </div>

                </div>


                <div class="form-group">

                    <label for="correctAnswer">
                        ✅ Correct Answer
                    </label>

                    <select id="correctAnswer" required>

                        <option value="">
                            Select the correct option
                        </option>

                        <option value="0">
                            Option 1
                        </option>

                        <option value="1">
                            Option 2
                        </option>

                        <option value="2">
                            Option 3
                        </option>

                        <option value="3">
                            Option 4
                        </option>

                    </select>

                </div>


                <button
                    type="submit"
                    class="primary-btn"
                >
                    🚀 Create Class
                </button>

            </form>


            <div
                id="class-created"
                class="class-code-box hidden"
            >

                <div class="success-icon">
                    🎉
                </div>

                <h2>Class Created Successfully!</h2>

                <p>
                    Share this unique code with your students.
                </p>

                <div class="generated-code">
                    <span id="generated-code">
                        ABC123
                    </span>
                </div>

                <button
                    class="secondary-btn"
                    onclick="copyClassCode()"
                >
                    📋 Copy Class Code
                </button>

            </div>

        </section>


        <section
            id="statistics-section"
            class="dashboard-card hidden"
        >

            <div class="card-heading">

                <div class="card-icon">
                    📊
                </div>

                <div>

                    <h2>Live Class Statistics</h2>

                    <p>
                        Student responses will appear here.
                    </p>

                </div>

            </div>


            <div class="stats-grid">

                <div class="stat-card">

                    <span>👥</span>

                    <h3 id="total-students">
                        0
                    </h3>

                    <p>Responses</p>

                </div>


                <div class="stat-card">

                    <span>😊</span>

                    <h3 id="understand-count">
                        0
                    </h3>

                    <p>Understand</p>

                </div>


                <div class="stat-card">

                    <span>🤔</span>

                    <h3 id="somewhat-count">
                        0
                    </h3>

                    <p>Somewhat</p>

                </div>


                <div class="stat-card">

                    <span>😕</span>

                    <h3 id="dont-understand-count">
                        0
                    </h3>

                    <p>Need Help</p>

                </div>

            </div>


            <div class="cri-box">

                <div>

                    <span>
                        Classroom Resonance Index
                    </span>

                    <strong id="cri-value">
                        0%
                    </strong>

                </div>

                <p id="class-status">
                    Waiting for responses
                </p>

            </div>

        </section>

    </main>


    <!-- Socket.IO MUST COME BEFORE OUR SCRIPT -->

    <script src="/socket.io/socket.io.js"></script>


    <script>

        // ==================================================
        // SOCKET.IO
        // ==================================================

        const socket = io();

        let currentClassCode = "";

        // ==================================================
// SOCKET CONNECTION
// ==================================================

socket.on("connect", function() {

    console.log(
        "Teacher connected to Socket.IO:",
        socket.id
    );

});


// ==================================================
// CLASS ROOM JOIN CONFIRMATION
// ==================================================

socket.on(
    "class-joined",
    function(code) {

        console.log(
            "Teacher joined class room:",
            code
        );

    }
);
        // ==================================================
        // CREATE CLASS
        // ==================================================

        document
            .getElementById("create-class-form")
            .addEventListener("submit", async function(event) {

                event.preventDefault();


                const topic =
                    document
                        .getElementById("topic")
                        .value
                        .trim();


                const quizQuestion =
                    document
                        .getElementById("quizQuestion")
                        .value
                        .trim();


                const quizOptions = [

                    document
                        .getElementById("option0")
                        .value
                        .trim(),

                    document
                        .getElementById("option1")
                        .value
                        .trim(),

                    document
                        .getElementById("option2")
                        .value
                        .trim(),

                    document
                        .getElementById("option3")
                        .value
                        .trim()

                ];


                const correctAnswer =
                    document
                        .getElementById("correctAnswer")
                        .value;


                if (
                    !topic ||
                    !quizQuestion ||
                    quizOptions.some(option => !option) ||
                    correctAnswer === ""
                ) {

                    alert("Please fill all fields.");

                    return;

                }


                try {

                    const response =
                        await fetch("/api/classrooms", {

                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({

                                topic: topic,

                                quizQuestion:
                                    quizQuestion,

                                quizOptions:
                                    quizOptions,

                                correctAnswer:
                                    Number(correctAnswer)

                            })

                        });


                    const data =
                        await response.json();


                    if (!response.ok) {

                        alert(
                            data.message ||
                            "Could not create class."
                        );

                        return;

                    }


                    currentClassCode =
                        data.code;


                    document
                        .getElementById("generated-code")
                        .textContent =
                        currentClassCode;


                    document
                        .getElementById("class-created")
                        .classList
                        .remove("hidden");


                    document
                        .getElementById("statistics-section")
                        .classList
                        .remove("hidden");


                    // Join teacher to this class room

                    socket.emit(
                        "join-class",
                        currentClassCode
                    );


                    // Load current statistics

                    loadStats();


                } catch (error) {

                    console.error(error);

                    alert(
                        "Unable to connect to server."
                    );

                }

            });


        // ==================================================
        // RECEIVE LIVE STATISTICS
        // ==================================================

        socket.on(
            "stats:update",
            function(stats) {

                console.log(
                    "Live statistics received:",
                    stats
                );

                updateStats(stats);

            }
        );


        // ==================================================
        // LOAD STATISTICS
        // ==================================================

        async function loadStats() {

            if (!currentClassCode) return;


            try {

                const response =
                    await fetch(
                        `/api/stats/${currentClassCode}`
                    );


                const stats =
                    await response.json();


                if (response.ok) {

                    updateStats(stats);

                }

            } catch (error) {

                console.error(
                    "Stats error:",
                    error
                );

            }

        }


        // ==================================================
        // UPDATE STATISTICS
        // ==================================================

        function updateStats(stats) {

            document
                .getElementById("total-students")
                .textContent =
                stats.total;


            document
                .getElementById("understand-count")
                .textContent =
                stats.understand;


            document
                .getElementById("somewhat-count")
                .textContent =
                stats.somewhat;


            document
                .getElementById("dont-understand-count")
                .textContent =
                stats.dontUnderstand;


            document
                .getElementById("cri-value")
                .textContent =
                stats.cri + "%";


            document
                .getElementById("class-status")
                .textContent =
                stats.status;

        }


        // ==================================================
        // COPY CLASS CODE
        // ==================================================

        function copyClassCode() {

            if (!currentClassCode) return;


            navigator
                .clipboard
                .writeText(currentClassCode)
                .then(function() {

                    alert(
                        "Class code copied!"
                    );

                })
                .catch(function() {

                    alert(
                        "Could not copy class code."
                    );

                });

        }


        // ==================================================
        // LOGOUT
        // ==================================================

        function logout() {

            window.location.href = "/";

        }

    </script>

</body>

</html>