<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>ClassPulse - Teacher Dashboard</title>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>

    <!-- ================= TEACHER PAGE ================= -->

    <section id="teacher-page" class="page active">


        <!-- HEADER -->

        <header class="dashboard-header">

            <div class="brand">

                <h1>ClassPulse</h1>

                <span>
                    Teacher Dashboard
                </span>

            </div>


            <div class="header-actions">

                <span id="teacher-name-display">
                    Teacher
                </span>

                <button
                    type="button"
                    class="logout-btn"
                    id="teacher-logout-btn">
                    Logout
                </button>

            </div>

        </header>


        <!-- MAIN -->

        <main class="dashboard-container">


            <!-- WELCOME -->

            <section class="welcome-card">

                <div>

                    <p class="small-label">
                        TEACHER DASHBOARD
                    </p>

                    <h2>
                        Welcome,
                        <span id="teacher-welcome-name">
                            Teacher
                        </span>
                    </h2>

                    <p>
                        Create classes and monitor classroom
                        engagement in real time.
                    </p>

                </div>

            </section>


            <!-- CREATE CLASS -->

            <section class="dashboard-card">

                <div class="card-header">

                    <div>

                        <p class="small-label">
                            CLASSROOM MANAGEMENT
                        </p>

                        <h3>
                            Create New Class
                        </h3>

                    </div>

                </div>


                <div class="create-class-grid">

                    <div class="form-group">

                        <label for="new-class-name">
                            Class Name
                        </label>

                        <input
                            type="text"
                            id="new-class-name"
                            placeholder="Example: Class 10 - A"
                        >

                    </div>


                    <div class="form-group">

                        <label for="new-class-subject">
                            Subject
                        </label>

                        <input
                            type="text"
                            id="new-class-subject"
                            placeholder="Example: Mathematics"
                        >

                    </div>

                </div>


                <button
                    type="button"
                    class="primary-btn"
                    id="create-class-btn">
                    Create Class
                </button>


                <div
                    id="created-class-info"
                    class="created-class hidden">

                    <span>
                        Class Created Successfully
                    </span>

                    <strong id="created-class-code">
                        ------
                    </strong>

                    <p>
                        Share this code with your students.
                    </p>

                </div>


                <p
                    id="create-class-message"
                    class="message">
                </p>

            </section>


            <!-- CLASS SELECTOR -->

            <section class="dashboard-card">

                <div class="card-header">

                    <div>

                        <p class="small-label">
                            YOUR CLASSROOMS
                        </p>

                        <h3>
                            Select Class
                        </h3>

                    </div>

                </div>


                <div
                    id="teacher-class-list"
                    class="class-list">

                    <p class="empty-state">
                        No classes created yet.
                    </p>

                </div>

            </section>


            <!-- STATS -->

            <section
                id="teacher-stats-section"
                class="hidden">


                <div class="stats-grid">


                    <!-- TOTAL STUDENTS -->

                    <div class="stat-card stat-primary">

                        <span class="stat-label">
                            Total Students
                        </span>

                        <strong
                            id="total-students">
                            0
                        </strong>

                        <p>
                            Students participated
                        </p>

                    </div>


                    <!-- HIGHLY ENGAGED -->

                    <div class="stat-card">

                        <span class="stat-label">
                            Highly Engaged
                        </span>

                        <strong
                            id="highly-engaged">
                            0
                        </strong>

                        <p>
                            High engagement
                        </p>

                    </div>


                    <!-- NEEDS ATTENTION -->

                    <div class="stat-card">

                        <span class="stat-label">
                            Needs Attention
                        </span>

                        <strong
                            id="needs-attention">
                            0
                        </strong>

                        <p>
                            May need support
                        </p>

                    </div>


                    <!-- AVERAGE -->

                    <div class="stat-card">

                        <span class="stat-label">
                            Avg Engagement
                        </span>

                        <strong
                            id="avg-engagement">
                            0%
                        </strong>

                        <p>
                            Overall classroom score
                        </p>

                    </div>

                </div>


                <!-- ENGAGEMENT -->

                <section class="dashboard-card">

                    <div class="card-header">

                        <div>

                            <p class="small-label">
                                CLASS ENGAGEMENT
                            </p>

                            <h3>
                                Engagement Overview
                            </h3>

                        </div>


                        <strong
                            id="class-engagement-percentage">
                            0%
                        </strong>

                    </div>


                    <div class="engagement-progress">

                        <div
                            id="engagement-progress-bar"
                            class="engagement-progress-fill">
                        </div>

                    </div>


                    <div class="engagement-distribution">


                        <div class="distribution-item">

                            <span>
                                High
                            </span>

                            <strong
                                id="high-percentage">
                                0%
                            </strong>

                        </div>


                        <div class="distribution-item">

                            <span>
                                Medium
                            </span>

                            <strong
                                id="medium-percentage">
                                0%
                            </strong>

                        </div>


                        <div class="distribution-item">

                            <span>
                                Low
                            </span>

                            <strong
                                id="low-percentage">
                                0%
                            </strong>

                        </div>

                    </div>

                </section>


                <!-- CLASS PULSE -->

                <section class="dashboard-card">

                    <div class="card-header">

                        <div>

                            <p class="small-label">
                                CLASSROOM PULSE
                            </p>

                            <h3>
                                Student Understanding
                            </h3>

                        </div>

                    </div>


                    <div class="pulse-stats">


                        <div class="pulse-stat stat-primary">

                            <span>
                                Understand
                            </span>

                            <strong
                                id="pulse-understand">
                                0
                            </strong>

                        </div>


                        <div class="pulse-stat">

                            <span>
                                Somewhat
                            </span>

                            <strong
                                id="pulse-somewhat">
                                0
                            </strong>

                        </div>


                        <div class="pulse-stat">

                            <span>
                                Need Help
                            </span>

                            <strong
                                id="pulse-dont-understand">
                                0
                            </strong>

                        </div>


                        <div class="pulse-stat">

                            <span>
                                Average Rating
                            </span>

                            <strong
                                id="pulse-average-rating">
                                0
                            </strong>

                        </div>

                    </div>


                    <div class="pulse-summary">

                        <span>
                            Classroom Resonance Index
                        </span>

                        <strong id="class-cri">
                            0
                        </strong>

                    </div>


                    <p
                        id="class-status"
                        class="class-status">
                        Waiting for student responses.
                    </p>

                </section>


                <!-- AI INSIGHT -->

                <section class="dashboard-card ai-dashboard-card">

                    <div class="card-header">

                        <div>

                            <p class="small-label">
                                AI INSIGHT
                            </p>

                            <h3>
                                Classroom Recommendation
                            </h3>

                        </div>

                    </div>


                    <div class="ai-insight-box">

                        <h4>
                            Engagement Insight
                        </h4>

                        <p id="teacher-ai-insight">
                            Waiting for classroom data...
                        </p>

                    </div>


                    <div class="recommendation-box">

                        <h4>
                            Recommended Action
                        </h4>

                        <p id="teacher-recommendation">
                            Student responses will generate
                            recommendations here.
                        </p>

                    </div>

                </section>


            </section>

        </main>

    </section>


    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/script.js"></script>

</body>

</html>