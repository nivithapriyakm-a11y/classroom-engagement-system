<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ClassPulse - AI Student Engagement System</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- =====================================================
         TOP NAVIGATION
    ====================================================== -->

    <header class="top-navbar">

        <div class="navbar-logo">
            <span class="logo-icon">📊</span>
            <span>ClassPulse</span>
        </div>

        <nav class="navbar-menu">

            <a href="#home">Home</a>

            <a href="#how-it-works">
                How It Works
            </a>

            <a href="#student">
                Student
            </a>

            <a href="#teacher">
                Teacher
            </a>

        </nav>

    </header>


    <!-- =====================================================
         LOGIN PAGE
    ====================================================== -->

    <main id="home" class="login-page">

        <div class="auth-container">


            <!-- =================================================
                 LEFT PURPLE BRAND SECTION
            ================================================== -->

            <section class="brand-section">

                <div class="brand-content">

                    <h1>
                        ClassPulse
                    </h1>

                    <h2>
                        Know Their Presence.<br>
                        Measure Their Engagement.
                    </h2>

                    <p class="brand-description">
                        Turn classroom participation into meaningful
                        insights with AI-powered engagement analysis.
                    </p>


                    <!-- EMOJIS -->
                    <div class="brand-emojis">

                        <span>🧑‍🏫</span>

                        <span>🤖</span>

                        <span>📚</span>

                        <span>✨</span>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 RIGHT LOGIN SECTION
            ================================================== -->

            <section class="auth-section">

                <div class="auth-card">


                    <!-- LOGIN / CREATE ACCOUNT TABS -->

                    <div class="auth-tabs">

                        <button
                            type="button"
                            class="auth-tab active"
                            id="login-tab"
                            onclick="showLogin()">

                            LOGIN

                        </button>


                        <button
                            type="button"
                            class="auth-tab"
                            id="register-tab"
                            onclick="showRegister()">

                            CREATE ACCOUNT

                        </button>

                    </div>


                    <!-- =================================================
                         LOGIN FORM
                    ================================================== -->

                    <div id="login-form-container">

                        <h2>
                            Welcome Back
                        </h2>

                        <p class="form-description">
                            Login to continue to ClassPulse
                        </p>


                        <form id="login-form">


                            <!-- EMAIL -->

                            <div class="form-group">

                                <label for="login-email">
                                    Email
                                </label>

                                <input
                                    type="email"
                                    id="login-email"
                                    name="email"
                                    placeholder="Enter your email"
                                    required>

                            </div>


                            <!-- PASSWORD -->

                            <div class="form-group">

                                <label for="login-password">
                                    Password
                                </label>

                                <input
                                    type="password"
                                    id="login-password"
                                    name="password"
                                    placeholder="Enter your password"
                                    required>

                            </div>


                            <!-- ROLE -->

                            <div class="role-selection">

                                <p>
                                    Role
                                </p>

                                <div class="role-buttons">

                                    <button
                                        type="button"
                                        class="role-btn active"
                                        id="student-role"
                                        onclick="selectRole('student')">

                                        Student

                                    </button>


                                    <button
                                        type="button"
                                        class="role-btn"
                                        id="teacher-role"
                                        onclick="selectRole('teacher')">

                                        Teacher

                                    </button>

                                </div>

                            </div>


                            <input
                                type="hidden"
                                id="login-role"
                                name="role"
                                value="student">


                            <!-- LOGIN BUTTON -->

                            <button
                                type="submit"
                                class="primary-btn">

                                Login

                            </button>


                            <p
                                id="login-message"
                                class="message">
                            </p>

                        </form>

                    </div>


                    <!-- =================================================
                         REGISTER FORM
                    ================================================== -->

                    <div
                        id="register-form-container"
                        class="hidden">

                        <h2>
                            Create Account
                        </h2>

                        <p class="form-description">
                            Join ClassPulse today
                        </p>


                        <form id="register-form">


                            <!-- NAME -->

                            <div class="form-group">

                                <label for="register-name">
                                    Name
                                </label>

                                <input
                                    type="text"
                                    id="register-name"
                                    name="name"
                                    placeholder="Enter your name"
                                    required>

                            </div>


                            <!-- EMAIL -->

                            <div class="form-group">

                                <label for="register-email">
                                    Email
                                </label>

                                <input
                                    type="email"
                                    id="register-email"
                                    name="email"
                                    placeholder="Enter your email"
                                    required>

                            </div>


                            <!-- PASSWORD -->

                            <div class="form-group">

                                <label for="register-password">
                                    Password
                                </label>

                                <input
                                    type="password"
                                    id="register-password"
                                    name="password"
                                    placeholder="Create a password"
                                    required>

                            </div>


                            <!-- ROLE -->

                            <div class="role-selection">

                                <p>
                                    Role
                                </p>

                                <div class="role-buttons">

                                    <button
                                        type="button"
                                        class="role-btn active"
                                        id="register-student-role"
                                        onclick="selectRegisterRole('student')">

                                        Student

                                    </button>


                                    <button
                                        type="button"
                                        class="role-btn"
                                        id="register-teacher-role"
                                        onclick="selectRegisterRole('teacher')">

                                        Teacher

                                    </button>

                                </div>

                            </div>


                            <input
                                type="hidden"
                                id="register-role"
                                name="role"
                                value="student">


                            <button
                                type="submit"
                                class="primary-btn">

                                Create Account

                            </button>


                            <p
                                id="register-message"
                                class="message">
                            </p>

                        </form>

                    </div>

                </div>

            </section>

        </div>

    </main>


    <!-- =====================================================
         HOW IT WORKS
    ====================================================== -->

    <section
        id="how-it-works"
        class="how-it-works">

        <div class="section-container">

            <h2>
                How ClassPulse Works
            </h2>

            <p class="section-description">
                ClassPulse helps teachers understand classroom
                participation and student engagement using
                AI-powered insights.
            </p>


            <div class="steps-container">


                <div class="step-card">

                    <div class="step-number">
                        01
                    </div>

                    <h3>
                        Create a Class
                    </h3>

                    <p>
                        Teachers can create classrooms and
                        invite students to join.
                    </p>

                </div>


                <div class="step-card">

                    <div class="step-number">
                        02
                    </div>

                    <h3>
                        Students Participate
                    </h3>

                    <p>
                        Students interact with classroom
                        activities and quizzes.
                    </p>

                </div>


                <div class="step-card">

                    <div class="step-number">
                        03
                    </div>

                    <h3>
                        Track Engagement
                    </h3>

                    <p>
                        ClassPulse collects participation
                        and engagement information.
                    </p>

                </div>


                <div class="step-card">

                    <div class="step-number">
                        04
                    </div>

                    <h3>
                        Get Insights
                    </h3>

                    <p>
                        AI-powered insights help teachers
                        understand their classroom better.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script src="/script.js"></script>

</body>
</html>